LLM_PROVIDER=mistral
LLM_STREAMING=true

# YOUR OPENAI API EY
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1-turbo

# YOUR MISTRAL API KEY
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-medium-latest

# YOUR AZURE API KEY
AZURE_API_KEY=
# YOUR AZURE BASE URL ending on ".services.ai.azure.com/openai/v1/"
AZURE_BASE_URL=
AZURE_MODEL=gpt-5-mini

# YOUR GEMINI API KEY
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# YOUR CLAUDE API KEY
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001

OLLAMA_MODEL=ministral-3:14b
OLLAMA_KEEP_ALIVE=0s
OLLAMA_THINK=false

# YOUR DISCORD TOKEN
DISCORD_TOKEN=

# YOUR MCP SERVER URLS, like "http://localhost:8001/mcp"
MCP_SERVER_URLS=

CHAT_SYSTEM_MESSAGE="Du bist Emanuel."
VOICE_SYSTEM_MESSAGE="Du bist Emanuel. Du bist im Discord Voice Channel. Halte dich deshalb kurz."

MAX_TURNS=4